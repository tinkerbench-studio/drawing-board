{
  "name": "@tinkerbench-studio/drawing-board",
  "version": "0.4.0",
  "description": "The committed snapshot of a claude.ai design canvas, one set of files per board, and the checks that keep it, the canvas and Storybook in step.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkerbench-studio/drawing-board.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "drawing-board": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "default": "./dist/samples.js"
    },
    "./samples/esbuild": {
      "types": "./dist/samples-esbuild.d.ts",
      "default": "./dist/samples-esbuild.js"
    },
    "./pictures": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "parse5": "7.3.0"
  },
  "peerDependencies": {
    "esbuild": ">=0.20.0",
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
