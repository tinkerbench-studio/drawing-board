{
  "name": "@tinkerbench-studio/drawing-board",
  "version": "0.1.0",
  "description": "The committed snapshot of a claude.ai design canvas, one set of files per board, and the checks that keep it, the canvas and Storybook in step.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "git+https://github.com/tinkerbench-studio/drawing-board.git" },
  "engines": { "node": ">=22" },
  "bin": { "drawing-board": "./dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "!dist/**/*.test.*"],
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
